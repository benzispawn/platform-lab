{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListAndReadS3Bucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::platform-lab-771983217432-sa-east-1-an",
                "arn:aws:s3:::platform-lab-771983217432-sa-east-1-an/*"
            ]
        }
    ]
}
