{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadNetworkState",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeVpcs",
                "ec2:DescribeVpcAttribute",
                "ec2:DescribeSubnets",
                "ec2:DescribeInternetGateways",
                "ec2:DescribeRouteTables",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeSecurityGroupRules",
                "ec2:DescribeKeyPairs",
                "ec2:DescribeInstances",
                "ec2:DescribeInstanceStatus",
                "ec2:DescribeImages",
                "ec2:DescribeTags"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
            }
        },
        {
            "Sid": "CreateOnlyIfTagged",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateVpc",
                "ec2:CreateSubnet",
                "ec2:CreateInternetGateway",
                "ec2:CreateRouteTable",
                "ec2:CreateSecurityGroup",
                "ec2:CreateKeyPair",
                "ec2:RunInstances"
            ],
            "Resource": [
                "arn:aws:ec2:sa-east-1:771983217432:vpc/*",
                "arn:aws:ec2:sa-east-1:771983217432:subnet/*",
                "arn:aws:ec2:sa-east-1:771983217432:internet-gateway/*",
                "arn:aws:ec2:sa-east-1:771983217432:route-table/*",
                "arn:aws:ec2:sa-east-1:771983217432:security-group/*",
                "arn:aws:ec2:sa-east-1:771983217432:key-pair/*",
                "arn:aws:ec2:sa-east-1:771983217432:instance/*"
            ],
            "Condition": {
                "StringEquals": { "aws:RequestTag/Project": "platform-lab" }
            }
        },
        {
            "Sid": "ActOnlyOnTaggedResources",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateSubnet",
                "ec2:CreateRouteTable",
                "ec2:CreateSecurityGroup",
                "ec2:RunInstances",
                "ec2:ModifyVpcAttribute",
                "ec2:ModifySubnetAttribute",
                "ec2:AttachInternetGateway",
                "ec2:DetachInternetGateway",
                "ec2:CreateRoute",
                "ec2:ReplaceRoute",
                "ec2:DeleteRoute",
                "ec2:AssociateRouteTable",
                "ec2:DisassociateRouteTable",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:StopInstances",
                "ec2:StartInstances",
                "ec2:TerminateInstances",
                "ec2:DeleteKeyPair",
                "ec2:DeleteSecurityGroup",
                "ec2:DeleteRouteTable",
                "ec2:DeleteInternetGateway",
                "ec2:DeleteSubnet",
                "ec2:DeleteVpc"
            ],
            "Resource": "arn:aws:ec2:sa-east-1:771983217432:*",
            "Condition": {
                "StringEquals": { "aws:ResourceTag/Project": "platform-lab" }
            }
        },
        {
            "Sid": "ResourcesCreatedImplicitly",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress"
            ],
            "Resource": [
                "arn:aws:ec2:sa-east-1::image/*",
                "arn:aws:ec2:sa-east-1:771983217432:network-interface/*",
                "arn:aws:ec2:sa-east-1:771983217432:volume/*",
                "arn:aws:ec2:sa-east-1:771983217432:security-group-rule/*"
            ]
        },
        {
            "Sid": "TagOnlyWhileCreating",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "arn:aws:ec2:sa-east-1:771983217432:*",
            "Condition": {
                "StringEquals": {
                    "ec2:CreateAction": [
                        "CreateVpc",
                        "CreateSubnet",
                        "CreateInternetGateway",
                        "CreateRouteTable",
                        "CreateSecurityGroup",
                        "CreateKeyPair",
                        "RunInstances"
                    ]
                }
            }
        },
        {
            "Sid": "AmazonLinuxAmiLookup",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:sa-east-1::parameter/aws/service/ami-amazon-linux-latest/*"
        }
    ]
}
